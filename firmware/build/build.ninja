#############################################
# Utility command for rebuild_cache

build esp-idf/log/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\codes\esp32\kommando\firmware\build\esp-idf\log && C:\Espressif\tools\cmake\4.0.3\bin\cmake.exe --regenerate-during-build -SC:\codes\esp32\kommando\firmware -BC:\codes\esp32\kommando\firmware\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build esp-idf/log/rebuild_cache: phony esp-idf/log/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build esp-idf/log/list_install_components: phony


#############################################
