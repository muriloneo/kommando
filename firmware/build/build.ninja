build esp-idf/log/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\codes\esp32\kommando\firmware\build\esp-idf\log && C:\Espressif\tools\cmake\4.0.3\bin\cmake-gui.exe -SC:\codes\esp32\kommando\firmware -BC:\codes\esp32\kommando\firmware\build"
