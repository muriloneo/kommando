# Build outputs
/build/
*.o
*.a
*.so
*.elf
*.bin
*.map
*.d
*.su
*.gas

# ESP-IDF outputs
sdkconfig.old
sdkconfig.rename
*.pyc
__pycache__/
.dependencies.lock

# OTA artifacts: ignore everywhere by default
/releases/**/*.ota
/releases/**/*.ota.json

# Allow OTA feed artifacts to be committed/pushed
!/releases/ota-feed/
!/releases/ota-feed/*.ota
!/releases/ota-feed/*.json

# Optional: keep feed folder in git even when empty
!/releases/ota-feed/.gitkeep

# AI context artifacts (regenerated by tools/ai-context.sh)
repo-context.md
repo-context.json
.ai/repo.xml
.ai/repo.json

# Keep .ai/skills/ directory and its prompts committed
!.ai/skills/
!.ai/skills/*.md

# VS Code local settings
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json

# Python/pip
*.egg-info/
dist/
build/
__pycache__/
venv/
env/

# Node/npm
node_modules/
npm-debug.log
package-lock.json

# macOS
.DS_Store
.AppleDouble

# Linux
*~
.Trash-*

# Windows
Thumbs.db
*.lnk
