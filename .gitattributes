# Normalize all text files to LF in repo, regardless of platform checkout
* text=auto eol=lf

# Explicit binaries (do not touch)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bin binary
*.elf binary
*.o   binary
*.a   binary
*.so  binary
*.dll binary
*.exe binary
*.zip binary
*.gz  binary
*.tar binary
*.7z  binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary

# Shell / batch scripts — keep platform-native EOL
*.sh  text eol=lf
*.bash text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
